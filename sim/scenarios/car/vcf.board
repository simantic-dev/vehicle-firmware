mux: SPI.SPIMultiplexer @ lpspi4
    ActiveLowMask: 0x3
vadc0: SPI.ScriptedSpiSlave @ mux 0
    file: "@SIMANTIC@/peers/car/vcf_adc0.py"
vadc1: SPI.ScriptedSpiSlave @ mux 1
    file: "@SIMANTIC@/peers/car/vcf_adc1.py"
gpio2:
    0 -> mux@0
gpio7:
    0 -> mux@0
gpio1:
    28 -> mux@1
gpio6:
    28 -> mux@1
expander: I2C.ScriptedI2cSlave @ lpi2c4 0x20
    file: "@SIMANTIC@/peers/car/dial.py"
    numberOfGpios: 2
enc: UART.ScriptedUartPeer @ sysbus 0x60200000
    file: "@SIMANTIC@/peers/car/enc.py"
    baudRate: 115200
btn: Scripted.ScriptedGpioPeer @ none
    file: "@SIMANTIC@/peers/generic/gpio/pin_script.py"
    config: "{\"idle\": {\"0\": 1, \"1\": 1}, \"holds\": [{\"line\": 0, \"at_ms\": 2300, \"for_ms\": 400, \"level\": 0}, {\"line\": 1, \"at_ms\": 9300, \"for_ms\": 300, \"level\": 0}]}"
    numberOfGpios: 2
    0 -> gpio4@31 | gpio9@31
    1 -> gpio3@22 | gpio8@22
sink2: CAN.ScriptedCanNode @ sysbus 0x80200000
    file: "@SIMANTIC@/peers/car/sink.py"
phy: Network.DP83825I @ enet 0
mon: CAN.ScriptedCanNode @ sysbus 0x80210000
    file: "@SIMANTIC@/peers/car/canlog.py"
