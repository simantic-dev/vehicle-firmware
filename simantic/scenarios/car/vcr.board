mux: SPI.SPIMultiplexer @ lpspi4
    ActiveLowMask: 0x3
adc0: SPI.ScriptedSpiSlave @ mux 0
    file: "@SIMANTIC@/peers/car/vcr_adc0.py"
adc1: SPI.ScriptedSpiSlave @ mux 1
    file: "@SIMANTIC@/peers/car/vcr_adc1.py"
gpio2:
    0 -> mux@0
    18 -> mux@1
gpio7:
    0 -> mux@0
    18 -> mux@1
expander: I2C.ScriptedI2cSlave @ lpi2c1 0x20
    file: "@SIM_FIXTURES@/peers/i2c/mcp23017.py"
    numberOfGpios: 2
invs: CAN.ScriptedCanNode @ sysbus 0x80210000
    file: "@SIMANTIC@/peers/car/inv4.py"
db: CAN.ScriptedCanNode @ sysbus 0x80200000
    file: "@SIMANTIC@/peers/car/db.py"
dbeth: Network.ScriptedEthernetPeer @ sysbus 0x80300000
    file: "@SIMANTIC@/peers/car/drivebrain_eth.py"
    mac: "02:00:00:00:00:30"
phy: Network.DP83825I @ enet 0
